{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "name": "chatdesk",
    "description": "ChatDesk, a self-hosted WhatsApp Cloud API platform.",
    "author": "Yoorie <support@yoorie.com> (https://yoorie.com)",
    "type": "module",
    "scripts": {
        "build": "tsc && vite build && vite build --ssr",
        "dev": "node scripts/dev.mjs",
        "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "dev:vite": "vite --host 127.0.0.1",
        "typecheck": "tsc --noEmit",
        "test:frontend": "node --experimental-strip-types --test tests/Frontend/*.test.mjs",
        "check:performance": "node scripts/check-performance.mjs"
    },
    "devDependencies": {
        "@headlessui/react": "^2.2.10",
        "@inertiajs/react": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@types/node": "^20.19.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.12",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.34.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-react": "^0.468.0",
        "postcss": "^8.4.31",
        "prettier": "^3.2.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^3.2.1",
        "typescript": "^5.0.2",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@types/qrcode": "^1.5.6",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.3.0",
        "pusher-js": "^8.4.0",
        "qrcode": "^1.5.4",
        "reactflow": "^11.11.4",
        "tailwind-merge": "^3.4.0"
    }
}
