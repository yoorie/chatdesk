# ChatDesk open-source edition by Yoorie (https://yoorie.com)
# Copy to .env, fill in the database and META_APP_SECRET, then run: php artisan key:generate && php artisan migrate --seed
APP_NAME=ChatDesk
# Use production in production; set APP_DEBUG=false and LOG_LEVEL=warning there
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# In production use warning or error; avoid debug (no PII/full message bodies in logs)
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=ChatDesk

# Pusher (optional realtime inbox). Set BROADCAST_CONNECTION=pusher after adding keys in Admin > Settings > Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Meta WhatsApp Cloud API. The number itself (Phone Number ID, WABA ID, token) is added in the app.
# META_APP_SECRET is required: Meta signs every webhook with it. See docs/connect-whatsapp.md
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
# Comma-separated extra Meta app secrets when multiple apps post to the same webhook URL
META_WEBHOOK_APP_SECRETS=
WHATSAPP_WEBHOOK_STRICT_SIGNATURE=true
WHATSAPP_WEBHOOK_ALLOWED_IPS=
WHATSAPP_WEBHOOK_RATE_LIMIT=100
WHATSAPP_WEBHOOK_RATE_LIMIT_DECAY=1
# Inbound whole-message opt-out / opt-in keywords (comma-separated) and auto-replies
WHATSAPP_OPT_OUT_KEYWORDS="stop,stop all,stopall,unsubscribe,cancel,end,quit"
WHATSAPP_OPT_IN_KEYWORDS="start,unstop,subscribe"
WHATSAPP_OPT_OUT_REPLY="You are unsubscribed and will not receive marketing messages. Reply START to opt back in."
WHATSAPP_OPT_IN_REPLY="You are subscribed again and can receive messages from us."
# Meta error 131049: per-recipient retry delay in seconds, and how many attempts before the send is failed
WHATSAPP_ECOSYSTEM_RETRY_DELAY=86400
WHATSAPP_ECOSYSTEM_RETRY_MAX=3


# Public display settings stay cached until saved in admin; use redis on multi-node hosts.
STATIC_SETTINGS_CACHE_STORE=file

# Shared hosting: the cron (schedule:run) drains the database queue every minute.
QUEUE_SCHEDULED_WORKER=true

# Demo mode for public preview sites only. Blocks all changes and masks secrets.
DEMO_MODE=false

# Optional OpenAI-compatible server for chatbot AI replies. Leave unset if unused.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Public preview logins. Defaults live in config/demo.php. Do not enable on a live site.
# DEMO_USER_EMAIL=owner@demo.chatdesk.test
# DEMO_USER_PASSWORD=demo1234
# DEMO_AGENT_EMAIL=agent@demo.chatdesk.test
# DEMO_AGENT_PASSWORD=demo1234
# DEMO_RESET_CRON="0 * * * *"
